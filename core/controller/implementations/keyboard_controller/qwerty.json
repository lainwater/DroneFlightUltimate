{
  "c":     { "on_press": "connect" },
  "v":     { "on_press": "set_arm" },
  "b":     { "on_press": "set_disarm" },
  "y":     { "on_press": "get_position" },
  "u":     { "on_press": "get_attitude" },

  "t":     { "on_press": "takeoff" },
  "l":     { "on_press": "land" },
  "space": { "on_press": "emergency" },

